{
  "name": "octo-chat-enhancer",
  "description": "给 Octo 网页版换套好看的皮肤，顺手把常用操作变快：消息美化与全站换肤、舒适输入框（含快捷 @ 群成员）、GitHub 快捷跳转和桌面宠物。",
  "private": true,
  "version": "0.7.0",
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "pixi-filters": "^6",
    "pixi.js": "^8",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.8.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
